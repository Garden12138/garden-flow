{
  "manifest_version": 3,
  "name": "GardenFlow 小红书发布",
  "version": "1.0.0",
  "description": "在用户明确确认后，将 GardenFlow 作品填写并发布到小红书创作服务平台。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GardenFlow 小红书发布",
    "default_popup": "popup.html"
  }
}
