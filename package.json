{
  "name": "garden-flow",
  "private": true,
  "description": "GardenFlow — Grow content with AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Garden12138/garden-flow.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm --dir Plugin install --frozen-lockfile && pnpm --dir desktop install --frozen-lockfile",
    "dev": "pnpm --dir desktop dev",
    "check": "pnpm check:brand && pnpm --dir desktop check:parity && pnpm --dir Plugin check",
    "test": "pnpm --dir desktop test",
    "build": "pnpm --dir desktop build:nosign",
    "build:plugin": "pnpm --dir Plugin build",
    "generate:brand-assets": "python3 scripts/generate-brand-assets.py",
    "migrate:data": "node desktop/scripts/gardenflow-data-migration.cjs",
    "sync:brand": "node scripts/sync-brand.cjs",
    "check:brand": "node scripts/check-brand.cjs"
  },
  "dependencies": {
    "@types/diff": "^7.0.2",
    "diff": "^8.0.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5"
  }
}
